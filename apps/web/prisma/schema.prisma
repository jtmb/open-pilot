datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Conversation {
  id        String @id
  title     String @default("New chat")
  createdAt BigInt
  updatedAt BigInt
  messages  String @default("[]")
}

model User {
  id        String  @id
  name      String
  email     String  @unique
  image     String?
  createdAt BigInt
  updatedAt BigInt
}

model ApiKey {
  id         String  @id
  name       String
  keyHash    String  @unique
  keyPrefix  String
  model      String  @default("gpt-4o")
  enabled    Boolean @default(true)
  createdAt  BigInt
  lastUsedAt BigInt?
  usageCount Int     @default(0)
}

// ─── Self-Training Models ────────────────────────────────────────────────────

model AgentRunRecord {
  id                   String         @id @default(uuid())
  personalityId        String
  personalityVersionId String?
  title                String
  spec                 String
  status               String         // 'complete' | 'blocked' | 'error'
  iterationCount       Int
  correctionCount      Int            @default(0)
  tokenPromptTotal     Int            @default(0)
  tokenCompletionTotal Int            @default(0)
  userRating           Int?           // 1=thumbs-up, -1=thumbs-down
  monitorFindings      String         @default("[]")
  summary              String?
  workerHistory        String         // JSON
  managerHistory       String         // JSON
  createdAt            BigInt
  completedAt          BigInt?
  steps                AgentRunStep[]
  version              PersonalityVersion? @relation(fields: [personalityVersionId], references: [id])
}

model AgentRunStep {
  id               String         @id @default(uuid())
  runId            String
  run              AgentRunRecord @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIndex        Int
  role             String         // 'worker' | 'manager'
  promptTokens     Int
  completionTokens Int
  createdAt        BigInt
}

model PersonalityVersion {
  id            String           @id @default(uuid())
  personalityId String
  version       Int
  workerSystem  String
  managerSystem String
  isActive      Boolean          @default(false)
  promotedAt    BigInt?
  createdAt     BigInt
  runs          AgentRunRecord[]

  @@unique([personalityId, version])
}

// ─── Active Agent Run State ──────────────────────────────────────────────────
// Stores the full serialised AgentRun (workerHistory, managerHistory, log, etc.)
// so runs survive browser sessions, private windows, and server restarts.

model AgentRunState {
  id        String @id
  state     String // Full AgentRun JSON
  createdAt BigInt
  updatedAt BigInt
}
