datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Conversation {
  id        String @id
  title     String @default("New chat")
  createdAt BigInt
  updatedAt BigInt
  messages  String @default("[]")
}

model User {
  id        String  @id
  name      String
  email     String  @unique
  image     String?
  createdAt BigInt
  updatedAt BigInt
}
