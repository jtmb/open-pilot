# Copy this file to docker/.env.prd and fill in all values.
# This file is intentionally NOT committed to source control.
#
# Usage:
#   docker compose -f docker-compose.yml -f docker-compose-prd.yml \
#     --env-file .env.prd up -d

# ── Domain ───────────────────────────────────────────────────────────────────
# Your public domain (must match the Cloudflare DNS record and GitHub OAuth
# callback URL: https://<PUBLIC_DOMAIN>/api/auth/callback/github)
PUBLIC_DOMAIN=app.example.com

# ── Web image ────────────────────────────────────────────────────────────────
# Pre-built Docker image for the web service.
# Build locally and push:
#   docker build -t ghcr.io/yourorg/openpilot-web:latest apps/web
#   docker push ghcr.io/yourorg/openpilot-web:latest
WEB_IMAGE=ghcr.io/yourorg/openpilot-web:latest

# ── Let's Encrypt ────────────────────────────────────────────────────────────
# Email used for certificate expiry notifications from Let's Encrypt.
ACME_EMAIL=you@example.com

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Random secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_random_secret

# ── GitHub OAuth App ─────────────────────────────────────────────────────────
# Create at: github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:      https://<PUBLIC_DOMAIN>
#   Callback URL:      https://<PUBLIC_DOMAIN>/api/auth/callback/github
GITHUB_ID=replace_with_your_github_client_id
GITHUB_SECRET=replace_with_your_github_client_secret

# ── Database ─────────────────────────────────────────────────────────────────
# Used by the web container — keep in sync with docker-compose.yml postgres block
DATABASE_URL=postgresql://openpilot:changeme@postgres:5432/openpilot

# ── code-server ──────────────────────────────────────────────────────────────
CODE_SERVER_URL=http://code-server:8080
CODE_SERVER_PASSWORD=replace_with_strong_password

# ── Optional: access password gate ───────────────────────────────────────────
# When set, the login screen requires this password before offline sign-in
# buttons are shown. GitHub OAuth is always available.
# ACCESS_PASSWORD=replace_with_strong_password
